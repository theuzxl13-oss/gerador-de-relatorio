# Copie para .env.local (desenvolvimento) ou configure no painel do Render.
# Nunca coloque valores reais deste arquivo no Git.

# PostgreSQL (Neon, Render, Supabase...). Sem esta variável, os dados ficam em ./dados/banco.json
# (somente fora de produção).
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# TLS do banco: verificar (padrão) | sem-verificacao | desativado (apenas banco local)
# DATABASE_SSL=verificar
# Cadeia de certificados do provedor (PEM; obrigatória para Supabase). Use \n para quebras de linha.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_CA_CERT_FILE=/caminho/para/ca.pem

# Admin Geral inicial (criado só enquanto não existe nenhum usuário; senha provisória).
# Obrigatório: não existe login padrão. Em produção a senha precisa ter 12+ caracteres.
APP_USUARIO=administracao
APP_SENHA=troque-por-uma-senha-local

# Chave das sessões (obrigatória em produção; 32+ caracteres aleatórios, ex.: openssl rand -base64 32).
# Fora de produção, se omitida, é gerada a cada reinício do servidor.
# SESSAO_SEGREDO=
# Durante a troca da chave: valor anterior (remova depois).
# SESSAO_SEGREDO_ANTERIOR=

# Com Cloudflare na frente: valor secreto que a Cloudflare envia no cabeçalho x-origem-segredo.
# ORIGEM_SEGREDO=

# Cria ocorrências demonstrativas na primeira execução (arquivo local: padrão true; PostgreSQL: só com true)
SEED_DEMO=true

# Habilita "Restaurar dados demonstrativos" (só fora de produção; em produção é sempre recusado)
PERMITIR_RESTAURAR_DEMO=true

# Fuso horário usado para a data automática dos relatórios
TZ=America/Sao_Paulo
