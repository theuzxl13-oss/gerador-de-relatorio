# Copie para .env.local (desenvolvimento) ou configure no painel do Render.

# PostgreSQL (Neon, Render, Supabase...). Sem esta variável, os dados ficam em ./dados/banco.json
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Administrador inicial (criado no primeiro acesso). Sem estas variáveis: admin / admin
# APP_USUARIO=administracao
# APP_SENHA=troque-esta-senha

# Cria ocorrências demonstrativas na primeira execução (true/false)
SEED_DEMO=true

# Permite o botão "Restaurar dados demonstrativos" em Configurações (use false em produção)
PERMITIR_RESTAURAR_DEMO=true

# Fuso horário usado para a data automática dos relatórios
TZ=America/Sao_Paulo

# Chave que assina as sessões de login (use um texto longo e aleatório em produção)
# SESSAO_SEGREDO=

# Com Cloudflare na frente: valor secreto que a Cloudflare envia no cabeçalho x-origem-segredo.
# Quando definido, o servidor recusa acessos que não passaram pela Cloudflare.
# ORIGEM_SEGREDO=
